  "css": "/*\n * Gojo Violet Nebula — wallpaper layer.\n *\n * Applied through the plugin's own <style> element, so it is removed again when\n * the plugin is disabled. The wallpaper is one fixed image behind the app shell;\n * the shell's opaque canvas columns are made transparent and the sidebar becomes\n * frosted glass so the artwork shows through without hurting legibility.\n */\n\nbody {\n  background-color: #0b0715 !important;\n  background-image:\n    radial-gradient(900px 620px at 16% 8%, rgba(168, 85, 247, 0.26), rgba(168, 85, 247, 0) 62%),\n    radial-gradient(820px 600px at 86% 92%, rgba(236, 72, 153, 0.20), rgba(236, 72, 153, 0) 62%),\n    linear-gradient(180deg, rgba(7, 4, 13, 0.92) 0%, rgba(7, 4, 13, 0.78) 34%, rgba(7, 4, 13, 0.88) 100%),\n    url(\"__WALLPAPER_URL__\");\n  background-size: auto, auto, auto, cover;\n  background-position: center center;\n  background-repeat: no-repeat;\n  background-attachment: fixed, fixed, fixed, fixed;\n}\n\n/* Light appearance: the same artwork washed out to a pale lavender paper. */\nbody:not([data-ds-dark-theme]) {\n  background-color: #f6f1ff !important;\n  background-image:\n    radial-gradient(900px 620px at 16% 8%, rgba(192, 132, 252, 0.34), rgba(192, 132, 252, 0) 62%),\n    radial-gradient(820px 600px at 86% 92%, rgba(244, 114, 182, 0.24), rgba(244, 114, 182, 0) 62%),\n    linear-gradient(180deg, rgba(251, 247, 255, 0.95) 0%, rgba(251, 247, 255, 0.90) 40%, rgba(246, 240, 255, 0.93) 100%),\n    url(\"__WALLPAPER_URL__\");\n}\n\n/* The app shell keeps its opaque canvas on top of the body; make the canvas\n * columns transparent so the fixed wallpaper stays visible. */\n.mP3x-q_frame,\n.mP3x-q_centerCol,\n.mP3x-q_bottomRow,\n[data-platform='darwin'] .mP3x-q_frame,\n[data-platform='darwin'] .mP3x-q_centerCol,\n[data-platform='darwin'] .mP3x-q_rightbarCol {\n  background: transparent !important;\n}\n\n/* The conversation column paints the canvas itself; let the artwork through. */\n.an3WzG_root {\n  background: transparent !important;\n}\n\n/* Keep the composer readable without hiding the artwork behind it. */\n.an3WzG_composerSeat {\n  background: linear-gradient(180deg, rgba(11, 7, 21, 0), color-mix(in srgb, var(--dsw-alias-bg-base) 88%, transparent) 36px) !important;\n}\n\nbody:not([data-ds-dark-theme]) .an3WzG_composerSeat {\n  background: linear-gradient(180deg, rgba(246, 241, 255, 0), color-mix(in srgb, var(--dsw-alias-bg-base) 88%, transparent) 36px) !important;\n}\n\n\n/* The sidebar keeps its own solid violet fill (--dsw-specific-sidebar-fill).\n * Do not glass it: a backdrop-filter on the sidebar column would become the\n * containing block of the fixed-position sidebar toggle buttons rendered inside\n * the collapsed sidebar, which hides the open/close controls. */\n\n@media (prefers-reduced-transparency: reduce) {\n  body,\n  body:not([data-ds-dark-theme]) {\n    background-image: none !important;\n    background-color: var(--dsw-alias-bg-base) !important;\n  }\n}\n\n",
